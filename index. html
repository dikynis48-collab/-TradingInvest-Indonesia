<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>TradingInvest Indonesia</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #08111f;
      color: white;
    }

    header {
      padding: 20px;
      background: #0d192b;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 22px;
      font-weight: bold;
    }

    .logo span {
      color: #4f8cff;
    }

    .login {
      background: #4f8cff;
      color: white;
      border: none;
      padding: 10px 18px;
      border-radius: 8px;
    }

    main {
      padding: 25px 18px;
      max-width: 1000px;
      margin: auto;
    }

    .hero {
      padding: 35px 0;
    }

    .hero h1 {
      font-size: 34px;
      margin-bottom: 12px;
    }

    .hero p {
      color: #9aa7ba;
      line-height: 1.6;
    }

    .buttons {
      margin-top: 22px;
    }

    .primary {
      background: #4f8cff;
      color: white;
      border: none;
      padding: 13px 20px;
      border-radius: 8px;
      font-weight: bold;
      margin-right: 8px;
    }

    .secondary {
      background: transparent;
      color: white;
      border: 1px solid #33445e;
      padding: 12px 20px;
      border-radius: 8px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 20px;
    }

    .card {
      background: #101d31;
      border: 1px solid #24344d;
      padding: 18px;
      border-radius: 12px;
    }

    .card p {
      color: #8d9aae;
      font-size: 13px;
      margin-bottom: 8px;
    }

    .card h2 {
      font-size: 22px;
    }

    .market {
      margin-top: 25px;
      background: #101d31;
      border: 1px solid #24344d;
      border-radius: 12px;
      padding: 18px;
    }

    .market h2 {
      margin-bottom: 15px;
    }

    .coin {
      display: flex;
      justify-content: space-between;
      padding: 15px 0;
      border-bottom: 1px solid #24344d;
    }

    .coin:last-child {
      border-bottom: none;
    }

    .green {
      color: #2bd576;
    }

    .red {
      color: #ff6577;
    }

    footer {
      text-align: center;
      color: #718096;
      padding: 35px 15px;
      font-size: 12px;
    }
  </style>
</head>

<body>

<header>
  <div class="logo">
    Trading<span>Invest</span>
  </div>

  <button class="login">
    Masuk
  </button>
</header>

<main>

  <section class="hero">
    <h1>Trading & Investasi</h1>

    <p>
      Platform untuk memantau market dan mengelola
      aktivitas trading dalam satu dashboard.
    </p>

    <div class="buttons">
      <button class="primary">
        Mulai Trading
      </button>

      <button class="secondary">
        Lihat Market
      </button>
    </div>
  </section>

  <section class="cards">

    <div class="card">
      <p>Saldo tersedia</p>
      <h2>Rp0</h2>
    </div>

    <div class="card">
      <p>Portfolio</p>
      <h2>Rp0</h2>
    </div>

  </section>

  <section class="market">

    <h2>Market</h2>

    <div class="coin">
      <strong>BTC / USDT</strong>
      <span class="green">$114,850.12</span>
    </div>

    <div class="coin">
      <strong>ETH / USDT</strong>
      <span class="green">$4,210.42</span>
    </div>

    <div class="coin">
      <strong>SOL / USDT</strong>
      <span class="red">$186.20</span>
    </div>

  </section>

</main>

<footer>
  TradingInvest Indonesia<br>
  Platform trading — tahap pengembangan
</footer>

</body>
</html>
